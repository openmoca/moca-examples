<!-- Central package management: every NuGet version lives here, once. -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The chat example talks to any OpenAI-compatible endpoint through the provider-neutral IChatClient. -->
  <ItemGroup>
    <PackageVersion Include="OpenMoca.Reader" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
